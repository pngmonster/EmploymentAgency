# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Django ───────────────────────────────────────────────────
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/static/          # собирается collectstatic, не хранится в git
/media/           # загружаемые файлы пользователей

# ── Environment / secrets ────────────────────────────────────
.env
.env.local
.env.*.local

# ── IDEs ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Coverage / tests ─────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.tox/

# ── Migrations (оставляем в git, только __pycache__ внутри) ──
apps/**/migrations/__pycache__/
